# ============================================================
# Rural Mobility Super App — Backend Environment Variables
# Copy this file to .env and fill in real values
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # development | production | test

# ── PostgreSQL (PostGIS) ─────────────────────────────────────
# Full connection string including postgis-enabled database
DATABASE_URL=postgresql://postgres:password@localhost:5432/rural_mobility

# ── Redis ────────────────────────────────────────────────────
# Used for driver location cache and session data
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password  # Uncomment if Redis requires auth

# ── Firebase ─────────────────────────────────────────────────
# Your Firebase project ID (found in Firebase Console → Project Settings)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Full JSON key for Firebase Admin SDK — escape newlines as \n for single-line
# Generate at: Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# ── Razorpay (Payments) ──────────────────────────────────────
# Obtain from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Mapping APIs ─────────────────────────────────────────────
# Google Maps — for geocoding and directions
GOOGLE_MAPS_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Mappls (MapMyIndia) — preferred for Indian roads
MAPPLS_API_KEY=your_mappls_api_key

# ── Route Matching ───────────────────────────────────────────
# How far (metres) a passenger stop can deviate from driver route
ROUTE_MAX_DEVIATION_METERS=500
# How long (seconds) a driver has to respond to a booking request
BOOKING_REQUEST_TIMEOUT_SECONDS=120
# How long (seconds) a driver location is considered fresh in Redis
LOCATION_CACHE_TTL_SECONDS=30

# ── Platform Business Rules ──────────────────────────────────
# Platform commission % on each ride (0 for pilot phase)
PLATFORM_COMMISSION_PCT=0
